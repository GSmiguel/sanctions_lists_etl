# Copy to .env (gitignored) and fill in. `uv run` does NOT auto-load .env —
# export it yourself, e.g.  set -a; . ./.env; set +a

# EU consolidated sanctions list (FSF) — access token for the FSD web gate
# bot/crawler download. Grab it from the "?token=..." part of the download
# link on https://webgate.ec.europa.eu/fsd/fsf#!/files
# This is a CREDENTIAL: it authenticates the download without a login. Never
# commit it.
EU_FSF_TOKEN=

# Alternatively, point at a file whose contents are the token:
# EU_FSF_TOKEN_FILE=/home/you/.secrets/eu_fsf.token

# Override the whole download URL (path/param changes):
# EU_FSF_URL=

# UN Security Council Consolidated List — no credential required. Only set this
# to override the whole download URL if the endpoint moves:
# UN_CONSOLIDATED_URL=
